{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grain Search",
  "version": "0.1.0",
  "identifier": "app.grainsearch.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Grain Search",
        "width": 756,
        "height": 100,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Grain Search contributors",
    "copyright": "Copyright (c) 2026 Grain Search contributors. MIT licence.",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Search your files and photos by meaning",
    "longDescription": "Grain Search finds documents by the sentences in them and photos by describing them, using Google's EmbeddingGemma 2 locally on your PC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
